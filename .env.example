# ZPS-OMS environment variables (copy to .env.local and adjust). Never commit .env.local.
# MySQL / MariaDB (XAMPP). Recommended: a dedicated least-privilege user instead of root.
DATABASE_URL=mysql://root@127.0.0.1:3306/zps_oms_dev
DATABASE_URL_TEST=mysql://root@127.0.0.1:3306/zps_oms_test
# Environment: development (default) | test | production (DEC-069). Production never seeds synthetic data,
# never shows the synthetic account list, and accepts only the Service's configured identifier formats.
# ZPS_ENVIRONMENT=development
# One-time token for /setup on an empty production database (at least 24 characters). Remove after setup.
# ZPS_SETUP_TOKEN=
# Production identifier formats (regular expressions, without ^ and $). Registration of a kind is refused until set.
# ZPS_FORMAT_SERVICE_NUMBER=
# ZPS_FORMAT_VEHICLE_REGISTRATION=
# ZPS_FORMAT_FLEET_REF=
# ZPS_FORMAT_ASSET_TAG=
# ZPS_FORMAT_STORE_CODE=
# ZPS_FORMAT_USERNAME=   (default in production: [a-z][a-z0-9._-]{2,40})
