{
  "name": "zps-oms",
  "version": "0.9.1",
  "private": true,
  "description": "ZPS-OMS local synthetic-data prototype. Not an authorised production police system.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "db:reset": "node --experimental-strip-types src/server/db/migrate.ts --reset --confirm-synthetic",
    "audit:routes": "node scripts/route-audit.mjs",
    "review:mobile": "node scripts/mobile-review.mjs",
    "verify:audit": "node scripts/verify-audit-chain.mjs",
    "docs:permissions": "node --experimental-strip-types scripts/gen-permission-matrix.mts",
    "docs:uat": "node --experimental-strip-types scripts/gen-uat.mts",
    "docs:completion": "node --experimental-strip-types scripts/gen-completion-docs.mts",
    "db:migrate": "node --experimental-strip-types src/server/db/migrate.ts",
    "test:e2e": "playwright test",
    "test:load": "node scripts/load-test.mjs",
    "test:security": "node scripts/security-probe.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "next": "^16.4.6",
    "pdfkit": "^0.15.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.7",
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
